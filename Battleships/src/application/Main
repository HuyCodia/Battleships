package application;

import java.io.IOException;

import javafx.application.Application;
import javafx.fxml.FXMLLoader;
import javafx.stage.Stage;
import javafx.scene.Scene;
import javafx.scene.layout.AnchorPane;


public class Main extends Application {

    /** initialise SERVER_IP */
    public static final String SERVER_IP = "193.26.159.1";

    /** declare Stage*/
    private Stage primaryStage;
    /** declare Scene */
    private Scene scene;

    /**
     * This method shows the start of the program
     *
     * @param  args String Array to start the program
     */
    public static void main(String[] args) {
        launch(args);
    }

    /**
     * This method starts with the primaryStage
     *
     * @param primaryStage
     */
    @Override
    public void start(Stage primaryStage) {
        this.primaryStage = primaryStage;
        mainWindow();
    }

    /** This method shows the look inside of the game */
    public void mainWindow() {
        try {
            FXMLLoader loader = new FXMLLoader(Main.class.getResource("MainWindow.fxml"));
            AnchorPane pane = loader.load();

            primaryStage.setMinHeight(820.00);
            primaryStage.setMinWidth(950.00);
            primaryStage.setMaxHeight(835.00);
            primaryStage.setMaxWidth(1165.00);

            MainWindowController mainWindowController = loader.getController();
            mainWindowController.setMain(this);

            scene = new Scene(pane);

            mainWindowController.updateUILanguage();

            primaryStage.setScene(scene);
            primaryStage.setTitle("Battleships");
            primaryStage.show();

            mainWindowController.setLanguageChoice();
            mainWindowController.initGame();

            mainWindowController.initGameFieldPanes();
            mainWindowController.repaintGamefields();
            mainWindowController.paintAvailableShips();

            mainWindowController.setViewToPregame();

            primaryStage.setOnCloseRequest((x) -> {
                System.exit(0);
            });
        }catch(IOException e) {
            e.printStackTrace();
        }
    }

    /**
     * This method gets all the necessary scenes
     *
     * @return scene
     */
    public Scene getScene() {
        return scene;
    }
}